  ],
  "body": [
    {
      "_type": "block",
      "_key": "step-0-0",
      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "text-0-0",
          "text": "Enter your account email",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "step-0-1",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "text-0-1",
          "text": "Open https://myaccount.axismeter.com/auth_clerk/sign-in, enter the email address you use for your Axis Meter account, and select Continue.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "step-1-0",
      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "text-1-0",
          "text": "Select Forgot password?",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "step-1-1",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "text-1-1",
          "text": "On the password screen, select Forgot password?, then select Reset your password to receive an email code.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "step-2-0",
      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "text-2-0",
          "text": "Check your email and enter the code",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "step-2-1",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "text-2-1",
          "text": "Find the six-digit code in your inbox and enter it on the sign-in page. Check your junk or spam folder if the email has not arrived.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "step-3-0",
      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "text-3-0",
          "text": "Choose your new password",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "step-3-1",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "text-3-1",
          "text": "Enter a strong new password, then enter it again in Confirm password. Follow the password requirements shown on the screen.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "step-4-0",
      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "text-4-0",
          "text": "Select Reset Password",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "step-4-1",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "text-4-1",
          "text": "Keep Sign out of all other devices selected if you want to end your other sessions. Select Reset Password to save your new password and sign in.",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "step-5-0",
      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "text-5-0",
          "text": "Still having trouble?",
          "marks": []
        }
      ]
    },
    {
      "_type": "block",
      "_key": "step-5-1",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "text-5-1",
          "text": "If your code has expired, select Resend and use the newest code. If you no longer have access to your account email, contact info@axismeter.com or call 226-702-5500.",
          "marks": []
        }
      ]
    }
  ],
