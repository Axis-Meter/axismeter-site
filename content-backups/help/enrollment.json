{
  "_createdAt": "2026-09-30T16:37:52Z",
  "_id": "help-enrollment",
  "_rev": "ANJ8VSfhOz4bxNByoq4FNf",
  "_type": "helpArticle",
  "_updatedAt": "2026-09-30T16:40:50Z",
  "archived": false,
  "body": [
    {
      "_key": "b0",
      "_type": "block",
      "children": [
        {
          "_key": "b0s",
          "_type": "span",
          "marks": [],
          "text": "Moving into a property served by Axis Meter? Follow this guide to apply for a new utility service account. The video uses a test applicant and sample details; enter your own information when you enroll."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b1",
      "_type": "block",
      "children": [
        {
          "_key": "b1s",
          "_type": "span",
          "marks": [],
          "text": "Before you begin, have your service address and unit number, move-in date, contact details, date of birth, and a copy of your identification ready. You will also need access to your email."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b2",
      "_type": "block",
      "children": [
        {
          "_key": "b2s",
          "_type": "span",
          "marks": [],
          "text": "Start your enrollment"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "b3",
      "_type": "block",
      "children": [
        {
          "_key": "b3a",
          "_type": "span",
          "marks": [],
          "text": "Open the "
        },
        {
          "_key": "b3b",
          "_type": "span",
          "marks": [
            "b3link"
          ],
          "text": "enrollment form"
        },
        {
          "_key": "b3c",
          "_type": "span",
          "marks": [],
          "text": ". Enter your first name, last name, email address and phone number."
        }
      ],
      "markDefs": [
        {
          "_key": "b3link",
          "_type": "link",
          "href": "https://myaccount.axismeter.com/signup"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "b4",
      "_type": "block",
      "children": [
        {
          "_key": "b4s",
          "_type": "span",
          "marks": [],
          "text": "Search for your building's address and select the matching address from the suggestions. Select Continue to Verification."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b5",
      "_type": "block",
      "children": [
        {
          "_key": "b5s",
          "_type": "span",
          "marks": [],
          "text": "Verify your email"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "b6",
      "_type": "block",
      "children": [
        {
          "_key": "b6s",
          "_type": "span",
          "marks": [],
          "text": "Open the email from Axis Meter and enter the six-digit verification code. The form continues to the enrollment details after your email is verified."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b7",
      "_type": "block",
      "children": [
        {
          "_key": "b7s",
          "_type": "span",
          "marks": [],
          "text": "If the email has not arrived, check your spam or junk folder. Use Resend Code when available and enter the newest code. Codes expire after 10 minutes."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b8",
      "_type": "block",
      "children": [
        {
          "_key": "b8s",
          "_type": "span",
          "marks": [],
          "text": "Add your service details"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "b9",
      "_type": "block",
      "children": [
        {
          "_key": "b9s",
          "_type": "span",
          "marks": [],
          "text": "Choose an individual or business account and check your name, phone number, email and service address. Business applicants should complete the company and authorized signer fields."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b10",
      "_type": "block",
      "children": [
        {
          "_key": "b10s",
          "_type": "span",
          "marks": [],
          "text": "Select your unit, enter your move-in date and the number of occupants, and provide your date of birth. The video uses unit HM at 14 Meinzinger Ave as an example; select your own building and unit."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b11",
      "_type": "block",
      "children": [
        {
          "_key": "b11a",
          "_type": "span",
          "marks": [],
          "text": "If you moved in more than 30 days ago, contact "
        },
        {
          "_key": "b11b",
          "_type": "span",
          "marks": [
            "b11link"
          ],
          "text": "info@axismeter.com"
        },
        {
          "_key": "b11c",
          "_type": "span",
          "marks": [],
          "text": " so the team can help set your service start date."
        }
      ],
      "markDefs": [
        {
          "_key": "b11link",
          "_type": "link",
          "href": "mailto:info@axismeter.com"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "b12",
      "_type": "block",
      "children": [
        {
          "_key": "b12s",
          "_type": "span",
          "marks": [],
          "text": "Upload your ID"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "b13",
      "_type": "block",
      "children": [
        {
          "_key": "b13s",
          "_type": "span",
          "marks": [],
          "text": "Select Upload ID and choose your identification file, such as a driver's license or passport. Accepted formats are JPG, PNG and PDF, up to 10 MB. The sample document shown in the tutorial is for demonstration only."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b14",
      "_type": "block",
      "children": [
        {
          "_key": "b14s",
          "_type": "span",
          "marks": [],
          "text": "Complete Different Billing Address or Additional Names on Account if either applies to you."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b15",
      "_type": "block",
      "children": [
        {
          "_key": "b15s",
          "_type": "span",
          "marks": [],
          "text": "Review fees and optional services"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "b16",
      "_type": "block",
      "children": [
        {
          "_key": "b16s",
          "_type": "span",
          "marks": [],
          "text": "Read the rate plan and additional fees shown for your service, then select the fee agreement checkbox. Fees shown in the video are examples from that building; review the current charges in your own application."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b17",
      "_type": "block",
      "children": [
        {
          "_key": "b17s",
          "_type": "span",
          "marks": [],
          "text": "If you want automatic payments from your bank account, select Sign Up for Pre-Authorized Payment (PAP) and provide the requested banking information and void cheque."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b18",
      "_type": "block",
      "children": [
        {
          "_key": "b18s",
          "_type": "span",
          "marks": [],
          "text": "Select Life-Saving Equipment if you use medical equipment that requires electricity, and complete the additional information requested."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b19",
      "_type": "block",
      "children": [
        {
          "_key": "b19s",
          "_type": "span",
          "marks": [],
          "text": "Sign and submit"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "b20",
      "_type": "block",
      "children": [
        {
          "_key": "b20s",
          "_type": "span",
          "marks": [],
          "text": "Read the Utility Service Contract and privacy information. Confirm the required acknowledgements, including that you are establishing a new service account."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b21",
      "_type": "block",
      "children": [
        {
          "_key": "b21s",
          "_type": "span",
          "marks": [],
          "text": "Type your full name exactly as shown on the form as your electronic signature. Check your details and select Submit Enrollment. Wait for the Enrollment Submitted confirmation before closing the page."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b22",
      "_type": "block",
      "children": [
        {
          "_key": "b22s",
          "_type": "span",
          "marks": [],
          "text": "Check your confirmation"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "b23",
      "_type": "block",
      "children": [
        {
          "_key": "b23s",
          "_type": "span",
          "marks": [],
          "text": "Check your inbox for the confirmation email and look in your spam or junk folder if needed. Axis Meter will review your application. The confirmation page states that review typically takes 1–2 business days."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b24",
      "_type": "block",
      "children": [
        {
          "_key": "b24s",
          "_type": "span",
          "marks": [],
          "text": "After approval, you will receive a welcome email with your account details. You can then sign in to view bills, make payments and manage your account."
        }
      ],
      "markDefs": [],
      "style": "normal"
    }
  ],
