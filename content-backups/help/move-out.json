{
  "_createdAt": "2026-09-30T16:47:23Z",
  "_id": "help-move-out",
  "_rev": "ANJ8VSfhOz4bxNByoqDXCs",
  "_type": "helpArticle",
  "_updatedAt": "2026-09-30T16:50:39Z",
  "archived": false,
  "body": [
    {
      "_key": "m0",
      "_type": "block",
      "children": [
        {
          "_key": "m0s",
          "_type": "span",
          "marks": [],
          "text": "Moving out of a property served by Axis Meter? Use your account's Move-out form to provide your service end date, forwarding address and final-invoice preferences."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "m1",
      "_type": "block",
      "children": [
        {
          "_key": "m1s",
          "_type": "span",
          "marks": [],
          "text": "Have your move-out date and new address ready. This video uses a demo account and sample details. It stops at the review screen without sending a move-out request."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "m2",
      "_type": "block",
      "children": [
        {
          "_key": "m2s",
          "_type": "span",
          "marks": [],
          "text": "Open Move-out"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "m3",
      "_type": "block",
      "children": [
        {
          "_key": "m3a",
          "_type": "span",
          "marks": [],
          "text": "Sign in to "
        },
        {
          "_key": "m3b",
          "_type": "span",
          "marks": [
            "m3link"
          ],
          "text": "My Account"
        },
        {
          "_key": "m3c",
          "_type": "span",
          "marks": [],
          "text": " and select Move-out under Service. Check that the service address and unit shown are the account you want to close."
        }
      ],
      "markDefs": [
        {
          "_key": "m3link",
          "_type": "link",
          "href": "https://myaccount.axismeter.com/"
        }
      ],
      "style": "normal"
    },
    {
      "_key": "m4",
      "_type": "block",
      "children": [
        {
          "_key": "m4s",
          "_type": "span",
          "marks": [],
          "text": "Set your service end date"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "m5",
      "_type": "block",
      "children": [
        {
          "_key": "m5s",
          "_type": "span",
          "marks": [],
          "text": "Choose the date your service should end and select your reason for moving. If you choose Other, enter the additional explanation requested. Select Continue."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "m6",
      "_type": "block",
      "children": [
        {
          "_key": "m6s",
          "_type": "span",
          "marks": [],
          "text": "Enter your forwarding address"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "m7",
      "_type": "block",
      "children": [
        {
          "_key": "m7s",
          "_type": "span",
          "marks": [],
          "text": "Search for your new address and select the matching suggestion. Check the confirmed address and add an apartment, unit or suite if needed. Use the address where you can be reached after moving out, then select Continue."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "m8",
      "_type": "block",
      "children": [
        {
          "_key": "m8s",
          "_type": "span",
          "marks": [],
          "text": "Choose your final-invoice preference"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "m9",
      "_type": "block",
      "children": [
        {
          "_key": "m9s",
          "_type": "span",
          "marks": [],
          "text": "Choose either Email PDF + auto-debit if PAP enrolled, or Email PDF only — I'll pay manually. The auto-debit option applies if you are already enrolled in pre-authorized payments."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "m10",
      "_type": "block",
      "children": [
        {
          "_key": "m10s",
          "_type": "span",
          "marks": [],
          "text": "Read the information about the final meter reading and any security deposit refund, then select Continue. Follow any refund instructions sent to you by Axis Meter."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "m11",
      "_type": "block",
      "children": [
        {
          "_key": "m11s",
          "_type": "span",
          "marks": [],
          "text": "Review and submit"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "m12",
      "_type": "block",
      "children": [
        {
          "_key": "m12s",
          "_type": "span",
          "marks": [],
          "text": "Check your move-out date, reason, forwarding address and final-invoice preference. Use Back to correct anything before submitting."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "m13",
      "_type": "block",
      "children": [
        {
          "_key": "m13s",
          "_type": "span",
          "marks": [],
          "text": "Read and select the acknowledgement about the prorated final invoice and any security deposit refund. When you are ready to schedule the move-out, select Submit move-out."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "m14",
      "_type": "block",
      "children": [
        {
          "_key": "m14s",
          "_type": "span",
          "marks": [],
          "text": "Submitting schedules the account for termination on the selected date and sends the request to Axis Meter for processing. The tutorial points out this button without submitting the demo account."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "m15",
      "_type": "block",
      "children": [
        {
          "_key": "m15s",
          "_type": "span",
          "marks": [],
          "text": "Keep your confirmation"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "m16",
      "_type": "block",
      "children": [
        {
          "_key": "m16s",
          "_type": "span",
          "marks": [],
          "text": "After a successful submission, the form displays Move-out submitted with a reference number. Check your email for confirmation and keep the reference for any follow-up."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "m17",
      "_type": "block",
      "children": [
        {
          "_key": "m17s",
          "_type": "span",
          "marks": [],
          "text": "Your final invoice follows the normal billing cycle and is prorated to your service end date. Follow the payment and refund instructions you receive."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "m18",
      "_type": "block",
      "children": [
        {
          "_key": "m18s",
          "_type": "span",
          "marks": [],
          "text": "If you need to change the request, reopen Move-out. Use Cancel request if that option is available, then submit a new request with the correct details. If cancellation is unavailable or processing has started, contact support."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "m19",
      "_type": "block",
      "children": [
        {
          "_key": "m19a",
          "_type": "span",
          "marks": [],
          "text": "For help with your move-out, email "
        },
        {
          "_key": "m19b",
          "_type": "span",
          "marks": [
            "m19link"
          ],
          "text": "info@axismeter.com"
        },
        {
          "_key": "m19c",
          "_type": "span",
          "marks": [],
          "text": " or call 226-702-5500."
        }
      ],
      "markDefs": [
        {
          "_key": "m19link",
          "_type": "link",
          "href": "mailto:info@axismeter.com"
        }
      ],
      "style": "normal"
    }
  ],
