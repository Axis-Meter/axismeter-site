{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "axismeter-site-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // No custom domain or routes on purpose: this worker is a workers.dev
  // preview only. DNS for axismeter.com still points at Vercel.
}
